// Firestore Security Rules - firebase.rules
// Rules file location: https://console.firebase.google.com → Firestore → Rules

// ============================================================================
// SECURE PRODUCTION RULES
// ============================================================================
// Use these rules ONLY after proper testing and security review

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================================================
    // USERS COLLECTION - User-Owned Documents
    // ========================================================================
    // Rule: Users can only read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Subcollection: User tasks
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Subcollection: User preferences
      match /preferences/{preference} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection: User items (CRUD demo)
      match /items/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // ========================================================================
    // TASKS COLLECTION - Public Tasks with Owner Verification
    // ========================================================================
    // Rule: Users can create tasks, but only update their own
    match /tasks/{taskId} {
      // Read: Authenticated users can read
      allow read: if request.auth != null;
      
      // Create: Authenticated users can create (sets ownerId automatically)
      allow create: if request.auth != null 
        && request.resource.data.ownerId == request.auth.uid;
      
      // Update: Only owner can update
      allow update: if request.auth != null 
        && resource.data.ownerId == request.auth.uid;
      
      // Delete: Only owner can delete
      allow delete: if request.auth != null 
        && resource.data.ownerId == request.auth.uid;
    }
    
    // ========================================================================
    // ADMIN OPERATIONS - Role-Based Access Control
    // ========================================================================
    // Rule: Only users with admin role can modify admin collection
    match /admin/{adminDoc} {
      allow read: if request.auth != null 
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      allow write: if request.auth != null 
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // ========================================================================
    // PUBLIC DATA - Read-Only for Authenticated Users
    // ========================================================================
    // Rule: Public collection that authenticated users can read (not write)
    match /publicData/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;  // No one can write to public data from app
    }
    
    // ========================================================================
    // MESSAGES COLLECTION - Chat/Messaging
    // ========================================================================
    // Rule: Users can read messages in conversations they're part of,
    //       and can only write if they're the sender
    match /conversations/{conversationId} {
      match /messages/{messageId} {
        allow read: if request.auth != null 
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        
        allow create: if request.auth != null 
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        
        allow update, delete: if request.auth != null 
          && resource.data.senderId == request.auth.uid;
      }
    }
    
    // ========================================================================
    // CATCH-ALL - DENY BY DEFAULT
    // ========================================================================
    // Any path not explicitly matched will be denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ============================================================================
// DEVELOPMENT/TESTING RULES
// ============================================================================
// Use ONLY during development with test data. NEVER in production.

